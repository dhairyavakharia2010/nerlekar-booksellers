{% if settings.show_announcement_bar %}
<div class="announcement-bar" style="background: var(--ink-900); color: var(--parchment-100);">
  <div class="container-book announcement-bar__inner">
    <span class="announcement-bar__item">
      <svg class="announcement-bar__icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M14 9h4l3 3v5a1 1 0 0 1-1 1h-2"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>
      {{ settings.announcement_text_1 }}
    </span>
    <span class="announcement-bar__divider"></span>
    <span class="announcement-bar__item">
      <svg class="announcement-bar__icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
      {{ settings.announcement_text_2 }}
    </span>
  </div>
</div>

<style>
.announcement-bar { font-size: 0.75rem; letter-spacing: 0.025em; }
.announcement-bar__inner {
  display: flex; align-items: center; justify-content: center; gap: 2rem;
  padding: 0.625rem 1rem; overflow: hidden;
}
.announcement-bar__item {
  display: flex; align-items: center; gap: 0.5rem; white-space: nowrap;
}
.announcement-bar__icon { color: var(--gold-400); flex-shrink: 0; }
.announcement-bar__divider {
  display: none; width: 1px; height: 12px;
  background: rgba(250, 246, 239, 0.2);
}
@media (min-width: 640px) {
  .announcement-bar__divider { display: block; }
}
</style>
{% endif %}
