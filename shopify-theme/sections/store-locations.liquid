<div class="store-locations section-padding">
  <div class="container-book">
    <div class="store-locations__header">
      <div class="divider-gold divider-gold-center"></div>
      <h2 class="store-locations__title">Visit Our Stores in Pune</h2>
      <p class="store-locations__subtitle">We welcome you to browse our shelves in person</p>
    </div>
    <div class="store-locations__grid">
      <div class="store-location card-warm">
        <div class="store-location__inner">
          <div class="store-location__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--gold-400)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div class="store-location__info">
            <h3 class="store-location__name">{{ settings.store_1_name }}</h3>
            <p class="store-location__address">{{ settings.store_1_address }}</p>
            <p class="store-location__address">Pune, Maharashtra</p>
            <div class="store-location__contacts">
              <a href="tel:{{ settings.store_1_phone }}" class="store-location__contact">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--gold-700)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                {{ settings.store_1_phone }}
              </a>
              <a href="https://wa.me/{{ settings.whatsapp_number }}" target="_blank" rel="noopener noreferrer" class="store-location__contact">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--gold-700)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                WhatsApp
              </a>
              <a href="mailto:{{ settings.contact_email }}" class="store-location__contact">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--gold-700)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                {{ settings.contact_email }}
              </a>
            </div>
          </div>
        </div>
      </div>
      <div class="store-location card-warm">
        <div class="store-location__inner">
          <div class="store-location__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--gold-400)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div class="store-location__info">
            <h3 class="store-location__name">{{ settings.store_2_name }}</h3>
            <p class="store-location__address">{{ settings.store_2_address }}</p>
            <p class="store-location__address">Pune, Maharashtra</p>
            <div class="store-location__contacts">
              <a href="tel:{{ settings.store_2_phone }}" class="store-location__contact">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--gold-700)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                {{ settings.store_2_phone }}
              </a>
              <a href="https://wa.me/{{ settings.whatsapp_number }}" target="_blank" rel="noopener noreferrer" class="store-location__contact">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--gold-700)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                WhatsApp
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.store-locations__header { text-align: center; margin-bottom: 3rem; }
.store-locations__title { font-family: var(--font-display); font-size: 1.875rem; color: var(--ink-900); }
@media (min-width: 1024px) { .store-locations__title { font-size: 2.25rem; } }
.store-locations__subtitle { margin-top: 0.75rem; color: var(--ink-600); }
.store-locations__grid { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
@media (min-width: 768px) { .store-locations__grid { grid-template-columns: 1fr 1fr; gap: 2rem; } }

.store-location { padding: 2rem; }
.store-location__inner { display: flex; align-items: flex-start; gap: 1rem; }
.store-location__icon { width: 48px; height: 48px; background: var(--ink-800); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.store-location__name { font-family: var(--font-display); font-size: 1.25rem; color: var(--ink-900); }
.store-location__address { font-size: 0.875rem; color: var(--ink-600); margin-top: 0.25rem; }
.store-location__contacts { margin-top: 1rem; display: flex; flex-direction: column; gap: 0.5rem; }
.store-location__contact { display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; color: var(--ink-700); transition: color 0.2s ease; }
.store-location__contact svg { flex-shrink: 0; }
.store-location__contact:hover { color: var(--gold-700); }
</style>

{% schema %}
{
  "name": "Store Locations",
  "settings": [],
  "presets": [{ "name": "Store Locations" }]
}
{% endschema %}
