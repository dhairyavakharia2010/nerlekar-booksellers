<section class="related-products" data-section-id="{{ section.id }}">
  <div class="container-book" style="padding-top: 4rem;">
    <div class="related-products__header">
      <h2 class="related-products__title">Related Books</h2>
      <div class="related-products__line"></div>
    </div>
    <div class="related-products__grid grid-4">
      {% assign current_product = product %}
      {% assign related_count = 0 %}
      {% for collection in product.collections %}
        {% for related in collection.products %}
          {% if related.id != current_product.id and related_count < 4 %}
            {% render 'product-card', product: related %}
            {% assign related_count = related_count | plus: 1 %}
          {% endif %}
        {% endfor %}
        {% if related_count >= 4 %}{% break %}{% endif %}
      {% endfor %}
      {% if related_count == 0 %}
        {% for related in collections.all.products limit: 4 %}
          {% if related.id != current_product.id %}
            {% render 'product-card', product: related %}
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

<style>
.related-products__header { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; }
.related-products__title { font-family: var(--font-display); font-size: 1.5rem; color: var(--ink-900); white-space: nowrap; }
@media (min-width: 1024px) { .related-products__title { font-size: 1.875rem; } }
.related-products__line { flex: 1; height: 1px; background: rgba(168, 145, 119, 0.15); }
</style>

{% schema %}
{
  "name": "Related Products",
  "settings": [
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 2,
      "default": 4
    }
  ]
}
{% endschema %}
