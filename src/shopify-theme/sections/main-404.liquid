<section class="not-found-page">
  <div class="container-book not-found-page__inner">
    <h1 class="not-found-page__title">Page Not Found</h1>
    <p class="not-found-page__text">The page you are looking for doesn't exist or has been moved.</p>
    <a href="{{ routes.root_url }}" class="btn-primary">
      Back to Home
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </a>
  </div>
</section>

<style>
.not-found-page__inner { padding: 6rem 0; text-align: center; }
.not-found-page__title { font-family: var(--font-display); font-size: 2.25rem; color: var(--ink-900); }
.not-found-page__text { color: var(--ink-600); margin-top: 0.75rem; margin-bottom: 2rem; }
</style>

{% schema %}
{
  "name": "404",
  "settings": []
}
{% endschema %}
