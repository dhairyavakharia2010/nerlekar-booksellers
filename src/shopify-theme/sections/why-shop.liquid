<div class="why-shop section-padding section-bg-warm">
  <div class="container-book">
    <div class="why-shop__header">
      <div class="divider-gold divider-gold-center"></div>
      <h2 class="why-shop__title">Why Shop With Us</h2>
    </div>
    <div class="why-shop__grid">
      <div class="why-shop__item">
        <div class="why-shop__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--gold-400)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        </div>
        <h3 class="why-shop__item-title">Carefully Selected</h3>
        <p class="why-shop__item-desc">A curated collection of religious and spiritual literature</p>
      </div>
      <div class="why-shop__item">
        <div class="why-shop__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--gold-400)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        </div>
        <h3 class="why-shop__item-title">Three Languages</h3>
        <p class="why-shop__item-desc">Books in Marathi, Hindi, and Sanskrit</p>
      </div>
      <div class="why-shop__item">
        <div class="why-shop__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--gold-400)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M14 9h4l3 3v5a1 1 0 0 1-1 1h-2"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>
        </div>
        <h3 class="why-shop__item-title">Pan-India Delivery</h3>
        <p class="why-shop__item-desc">Shipping to every state across India</p>
      </div>
      <div class="why-shop__item">
        <div class="why-shop__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--gold-400)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        </div>
        <h3 class="why-shop__item-title">Online Ordering</h3>
        <p class="why-shop__item-desc">Convenient browsing and ordering from home</p>
      </div>
    </div>
  </div>
</div>

<style>
.why-shop__header { text-align: center; margin-bottom: 3rem; }
.why-shop__title { font-family: var(--font-display); font-size: 1.875rem; color: var(--ink-900); }
@media (min-width: 1024px) { .why-shop__title { font-size: 2.25rem; } }
.why-shop__grid { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
@media (min-width: 640px) { .why-shop__grid { grid-template-columns: 1fr 1fr; } }
@media (min-width: 1024px) { .why-shop__grid { grid-template-columns: repeat(4, 1fr); gap: 1.5rem; } }
.why-shop__item { text-align: center; padding: 0 1rem; }
.why-shop__icon { width: 56px; height: 56px; background: var(--ink-800); margin: 0 auto 1.25rem; display: flex; align-items: center; justify-content: center; }
.why-shop__item-title { font-family: var(--font-display); font-size: 1.125rem; color: var(--ink-900); letter-spacing: 0.025em; }
.why-shop__item-desc { margin-top: 0.5rem; font-size: 0.875rem; color: var(--ink-600); line-height: 1.6; }
</style>

{% schema %}
{
  "name": "Why Shop",
  "settings": [],
  "presets": [{ "name": "Why Shop With Us" }]
}
{% endschema %}
