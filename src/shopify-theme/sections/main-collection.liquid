<section class="collection-page" data-section-id="{{ section.id }}">
  {%- comment -%} Page header {%- endcomment -%}
  <div class="collection-page__header">
    <div class="container-book">
      <div class="collection-page__eyebrow">
        <div class="collection-page__eyebrow-line"></div>
        <span>Bookstore</span>
      </div>
      <h1 class="collection-page__title">{{ collection.title | default: 'Browse Our Collection' }}</h1>
      <p class="collection-page__subtitle">Religious, spiritual, and Sanskrit literature in Marathi, Hindi, and Sanskrit</p>
    </div>
  </div>

  <div class="container-book collection-page__body">
    {%- comment -%} Mobile toolbar {%- endcomment -%}
    <div class="collection-page__mobile-toolbar">
      <button class="collection-page__filter-btn" data-collection-filter-toggle>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="21" y1="4" x2="14" y2="4"/><line x1="10" y1="4" x2="3" y2="4"/><line x1="21" y1="12" x2="12" y2="12"/><line x1="8" y1="12" x2="3" y2="12"/><line x1="21" y1="20" x2="16" y2="20"/><line x1="12" y1="20" x2="3" y2="20"/><line x1="14" y1="2" x2="14" y2="6"/><line x1="8" y1="10" x2="8" y2="14"/><line x1="16" y1="18" x2="16" y2="22"/></svg>
        Filters
      </button>
      <div class="collection-page__mobile-sort">
        <select class="input-book collection-page__sort-select" onchange="window.location.href=this.value;">
          <option value="{{ collection.url }}?sort_by=manual"{% if collection.sort_by == 'manual' %} selected{% endif %}>Featured</option>
          <option value="{{ collection.url }}?sort_by=price-ascending"{% if collection.sort_by == 'price-ascending' %} selected{% endif %}>Price: Low to High</option>
          <option value="{{ collection.url }}?sort_by=price-descending"{% if collection.sort_by == 'price-descending' %} selected{% endif %}>Price: High to Low</option>
          <option value="{{ collection.url }}?sort_by=title-ascending"{% if collection.sort_by == 'title-ascending' %} selected{% endif %}>Title: A to Z</option>
        </select>
      </div>
    </div>

    <div class="collection-page__layout">
      {%- comment -%} Desktop sidebar filters {%- endcomment -%}
      <aside class="collection-page__sidebar">
        <div class="collection-page__sidebar-inner">
          <h2 class="collection-page__filter-title">Filters</h2>

          {%- comment -%} Collections {%- endcomment -%}
          <div class="collection-page__filter-group">
            <label class="label-book">Categories</label>
            <div class="collection-page__filter-links">
              <a href="{{ routes.all_products_collection_url }}" class="collection-page__filter-link {% if collection.handle == 'all' or collection.handle == blank %}is-active{% endif %}">All Books</a>
              {% for col in collections %}
                <a href="{{ col.url }}" class="collection-page__filter-link {% if col.handle == collection.handle %}is-active{% endif %}">{{ col.title }}</a>
              {% endfor %}
            </div>
          </div>

          {%- comment -%} Language filter via tags {%- endcomment -%}
          <div class="collection-page__filter-group">
            <label class="label-book">Language</label>
            <div class="collection-page__filter-links">
              {% assign current_tags = current_tags | default: '' %}
              {% assign languages = 'Marathi,Hindi,Sanskrit,English' | split: ',' %}
              {% for lang in languages %}
                {% assign lang_tag = lang | downcase %}
                <a href="{{ collection.url }}/tagged/{{ lang_tag }}" class="collection-page__filter-link {% if current_tags contains lang_tag %}is-active{% endif %}">{{ lang }}</a>
              {% endfor %}
            </div>
          </div>

          {%- comment -%} Sort {%- endcomment -%}
          <div class="collection-page__filter-group">
            <label class="label-book">Sort By</label>
            <select class="input-book collection-page__sort-select" onchange="window.location.href=this.value;">
              <option value="{{ collection.url }}?sort_by=manual"{% if collection.sort_by == 'manual' or collection.sort_by == blank %} selected{% endif %}>Featured</option>
              <option value="{{ collection.url }}?sort_by=price-ascending"{% if collection.sort_by == 'price-ascending' %} selected{% endif %}>Price: Low to High</option>
              <option value="{{ collection.url }}?sort_by=price-descending"{% if collection.sort_by == 'price-descending' %} selected{% endif %}>Price: High to Low</option>
              <option value="{{ collection.url }}?sort_by=title-ascending"{% if collection.sort_by == 'title-ascending' %} selected{% endif %}>Title: A to Z</option>
            </select>
          </div>
        </div>
      </aside>

      {%- comment -%} Main content {%- endcomment -%}
      <div class="collection-page__main">
        <div class="collection-page__toolbar">
          <p class="collection-page__count">{{ paginate.items }} {% if paginate.items == 1 %}book{% else %}books{% endif %} found</p>
        </div>

        {% if collection.products.size > 0 %}
          <div class="collection-page__grid grid-4">
            {% for product in collection.products %}
              {% render 'product-card', product: product %}
            {% endfor %}
          </div>

          {% if paginate.pages > 1 %}
            <div class="collection-page__pagination">
              {% if paginate.previous %}
                <a href="{{ paginate.previous.url }}" class="collection-page__page-btn">&laquo; Previous</a>
              {% endif %}
              {% for part in paginate.parts %}
                {% if part.is_link %}
                  <a href="{{ part.url }}" class="collection-page__page-num">{{ part.title }}</a>
                {% else %}
                  <span class="collection-page__page-num is-current">{{ part.title }}</span>
                {% endif %}
              {% endfor %}
              {% if paginate.next %}
                <a href="{{ paginate.next.url }}" class="collection-page__page-btn">Next &raquo;</a>
              {% endif %}
            </div>
          {% endif %}
        {% else %}
          <div class="collection-page__empty">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--brown-400)" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            <p class="collection-page__empty-title">No books found</p>
            <p class="collection-page__empty-text">Try adjusting your filters or browse all books</p>
            <a href="{{ routes.all_products_collection_url }}" class="btn-secondary">Browse All Books</a>
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  {%- comment -%} Mobile filter drawer {%- endcomment -%}
  <div class="collection-page__filter-overlay" data-collection-filter-overlay></div>
  <div class="collection-page__filter-drawer" data-collection-filter-drawer>
    <div class="collection-page__filter-drawer-header">
      <h2 class="collection-page__filter-drawer-title">Filters</h2>
      <button class="collection-page__filter-drawer-close" data-collection-filter-close aria-label="Close filters">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="collection-page__filter-drawer-body">
      <div class="collection-page__filter-group">
        <label class="label-book">Categories</label>
        <div class="collection-page__filter-links">
          <a href="{{ routes.all_products_collection_url }}" class="collection-page__filter-link">All Books</a>
          {% for col in collections %}
            <a href="{{ col.url }}" class="collection-page__filter-link {% if col.handle == collection.handle %}is-active{% endif %}">{{ col.title }}</a>
          {% endfor %}
        </div>
      </div>
      <div class="collection-page__filter-group">
        <label class="label-book">Language</label>
        <div class="collection-page__filter-links">
          {% assign languages = 'Marathi,Hindi,Sanskrit,English' | split: ',' %}
          {% for lang in languages %}
            {% assign lang_tag = lang | downcase %}
            <a href="{{ collection.url }}/tagged/{{ lang_tag }}" class="collection-page__filter-link">{{ lang }}</a>
          {% endfor %}
        </div>
      </div>
      <div class="collection-page__filter-group">
        <label class="label-book">Sort By</label>
        <select class="input-book" onchange="window.location.href=this.value;">
          <option value="{{ collection.url }}?sort_by=manual">Featured</option>
          <option value="{{ collection.url }}?sort_by=price-ascending">Price: Low to High</option>
          <option value="{{ collection.url }}?sort_by=price-descending">Price: High to Low</option>
          <option value="{{ collection.url }}?sort_by=title-ascending">Title: A to Z</option>
        </select>
      </div>
    </div>
  </div>
</section>

<style>
.collection-page__header { background: var(--ink-900); color: var(--parchment-100); padding: 3rem 0; }
@media (min-width: 1024px) { .collection-page__header { padding: 4rem 0; } }
.collection-page__eyebrow { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem; }
.collection-page__eyebrow-line { height: 1px; width: 2.5rem; background: var(--gold-500); }
.collection-page__eyebrow span { font-size: 0.75rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--gold-400); }
.collection-page__title { font-family: var(--font-display); font-size: 1.875rem; }
@media (min-width: 1024px) { .collection-page__title { font-size: 3rem; } }
.collection-page__subtitle { margin-top: 0.75rem; color: rgba(245, 239, 227, 0.5); max-width: 36rem; }

.collection-page__body { padding: 2.5rem 0; }
@media (min-width: 1024px) { .collection-page__body { padding: 3.5rem 0; } }

.collection-page__mobile-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; }
@media (min-width: 1024px) { .collection-page__mobile-toolbar { display: none; } }
.collection-page__filter-btn { display: inline-flex; align-items: center; gap: 0.5rem; border: 1px solid rgba(168, 145, 119, 0.3); padding: 0.625rem 1rem; font-size: 0.875rem; color: var(--ink-800); }
.collection-page__mobile-sort { flex-shrink: 0; }
.collection-page__sort-select { width: auto; }

.collection-page__layout { display: flex; gap: 2.5rem; }

.collection-page__sidebar { display: none; }
@media (min-width: 1024px) { .collection-page__sidebar { display: block; width: 16rem; flex-shrink: 0; } }
.collection-page__sidebar-inner { position: sticky; top: 7rem; }
.collection-page__filter-title { font-family: var(--font-display); font-size: 1.125rem; color: var(--ink-900); margin-bottom: 1.25rem; padding-bottom: 0.75rem; border-bottom: 1px solid rgba(168, 145, 119, 0.15); }
.collection-page__filter-group { margin-bottom: 1.5rem; }
.collection-page__filter-links { display: flex; flex-direction: column; gap: 0.5rem; }
.collection-page__filter-link { font-size: 0.875rem; color: var(--ink-600); transition: color 0.2s ease; }
.collection-page__filter-link:hover { color: var(--gold-700); }
.collection-page__filter-link.is-active { color: var(--gold-700); font-weight: 500; }

.collection-page__main { flex: 1; min-width: 0; }
.collection-page__toolbar { display: none; padding-bottom: 1rem; margin-bottom: 1.5rem; border-bottom: 1px solid rgba(168, 145, 119, 0.15); }
@media (min-width: 1024px) { .collection-page__toolbar { display: flex; align-items: center; justify-content: space-between; } }
.collection-page__count { font-size: 0.875rem; color: var(--ink-600); }

.collection-page__empty { text-align: center; padding: 5rem 0; }
.collection-page__empty-title { font-family: var(--font-serif); font-size: 1.25rem; color: var(--ink-800); margin-top: 1rem; }
.collection-page__empty-text { font-size: 0.875rem; color: var(--ink-500); margin-top: 0.5rem; margin-bottom: 1.5rem; }

.collection-page__pagination { display: flex; align-items: center; justify-content: center; gap: 0.5rem; margin-top: 3rem; }
.collection-page__page-num { padding: 0.5rem 0.875rem; font-size: 0.875rem; color: var(--ink-600); border: 1px solid rgba(168, 145, 119, 0.15); transition: all 0.2s ease; }
.collection-page__page-num:hover { color: var(--gold-700); border-color: var(--gold-600); }
.collection-page__page-num.is-current { background: var(--ink-800); color: var(--parchment-100); border-color: var(--ink-800); }
.collection-page__page-btn { padding: 0.5rem 1rem; font-size: 0.875rem; color: var(--ink-600); transition: color 0.2s ease; }
.collection-page__page-btn:hover { color: var(--gold-700); }

.collection-page__filter-overlay { position: fixed; inset: 0; background: rgba(31, 20, 13, 0.5); z-index: 50; opacity: 0; pointer-events: none; transition: opacity 0.3s ease; }
.collection-page__filter-overlay.is-visible { opacity: 1; pointer-events: auto; }
@media (min-width: 1024px) { .collection-page__filter-overlay { display: none; } }

.collection-page__filter-drawer { position: fixed; left: 0; top: 0; bottom: 0; width: 85%; max-width: 24rem; background: var(--parchment-50); z-index: 50; overflow-y: auto; transform: translateX(-100%); transition: transform 0.3s ease; }
.collection-page__filter-drawer.is-open { transform: translateX(0); }
@media (min-width: 1024px) { .collection-page__filter-drawer { display: none; } }
.collection-page__filter-drawer-header { display: flex; align-items: center; justify-content: space-between; padding: 1.25rem; border-bottom: 1px solid rgba(168, 145, 119, 0.15); }
.collection-page__filter-drawer-title { font-family: var(--font-display); font-size: 1.125rem; color: var(--ink-900); }
.collection-page__filter-drawer-close { color: var(--ink-500); padding: 0.25rem; }
.collection-page__filter-drawer-body { padding: 1.25rem; }
</style>

<script>
  (function() {
    var toggle = document.querySelector('[data-collection-filter-toggle]');
    var drawer = document.querySelector('[data-collection-filter-drawer]');
    var overlay = document.querySelector('[data-collection-filter-overlay]');
    var close = document.querySelector('[data-collection-filter-close]');
    if (!toggle || !drawer) return;
    function openFilter() { drawer.classList.add('is-open'); if(overlay) overlay.classList.add('is-visible'); document.body.style.overflow = 'hidden'; }
    function closeFilter() { drawer.classList.remove('is-open'); if(overlay) overlay.classList.remove('is-visible'); document.body.style.overflow = ''; }
    toggle.addEventListener('click', openFilter);
    if (close) close.addEventListener('click', closeFilter);
    if (overlay) overlay.addEventListener('click', closeFilter);
  })();
</script>

{% schema %}
{
  "name": "Collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 12,
      "max": 48,
      "step": 4,
      "default": 24
    }
  ]
}
{% endschema %}
